-- Keybind ------------------------------------------------------------
function SectionClass:AddKeybind(o)
    o = o or {}
    local win = self.Window
    local mode = o.Mode or "Press" -- Press | Hold | Toggle
    local row = self:_row(32)
    win:_label(row, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -120, 1, 0), Text = o.Name or "Keybind" })
    local btn = New("TextButton", {
        Size = UDim2.fromOffset(96, 22), Position = UDim2.new(1, -104, 0.5, -11), Font = Enum.Font.GothamMedium, TextSize = 12,
        AutoButtonColor = false, Text = "", Parent = row,
    })
    Corner(btn, 5)
    win:_bindTheme(btn, "BackgroundColor3", "Section")
    win:_bindTheme(btn, "TextColor3", "Accent")
    win:_hover(row)

    local obj = { Name = o.Name, Value = "None", State = false }
    local listening = false
    local function keyText() return listening and ". . ." or obj.Value end
    function obj:Get() return self.Value end
    function obj:Serialize() return self.Value end
    function obj:Set(v, silent)
        if typeof(v) == "EnumItem" then v = v.Name end
        self.Value = (v == nil or v == "") and "None" or tostring(v)
        btn.Text = keyText()
        if not silent and o.BindChanged then pcall(o.BindChanged, self.Value) end
        win:_emit(self, self.Value, true)
        if not silent then for _, fn in ipairs(self._listeners or {}) do pcall(fn, self.Value) end end
    end
    function obj:Deserialize(v) self:Set(v) end
    function obj:GetState() return self.State end
    if o.Default then obj.Value = typeof(o.Default) == "EnumItem" and o.Default.Name or tostring(o.Default) end
    btn.Text = keyText()

    btn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true; win._listening = true
        btn.Text = keyText()
    end)
    win:_connect(UserInputService.InputBegan, function(input, gpe)
        local name = KeyName(input)
        if not name then return end
        if listening then
            listening = false
            task.defer(function() win._listening = false end)
            if name == "Escape" or name == "Backspace" then obj:Set("None") else obj:Set(name) end
            return
        end
        if gpe or win._listening or obj.Value == "None" or name ~= obj.Value then return end
        local cb = o.Callback
        if mode == "Press" then
            if cb then pcall(cb) end
        elseif mode == "Toggle" then
            obj.State = not obj.State
            if cb then pcall(cb, obj.State) end
        elseif mode == "Hold" then
            obj.State = true
            if cb then pcall(cb, true) end
        end
    end)
    win:_connect(UserInputService.InputEnded, function(input)
        if mode == "Hold" and obj.State and KeyName(input) == obj.Value then
            obj.State = false
            if o.Callback then pcall(o.Callback, false) end
        end
    end)
    local registered = self:_register(obj, row, { Name = o.Name, Flag = o.Flag, NoSave = o.NoSave, Tooltip = o.Tooltip, Visible = o.Visible }, "Keybind", true)
    registered.Callback = nil -- activation callback is handled by the input handlers above
    return registered
end

