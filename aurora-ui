function WindowClass:_newTab(name, icon, listParent)
    local tab = setmetatable({ Name = name or "Tab", Window = self, Sections = {} }, TabClass)
    local btn = New("TextButton", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", BorderSizePixel = 0, Parent = listParent })
    Corner(btn, 6)
    local ind = New("Frame", { Position = UDim2.new(0, 0, 0.5, -8), Size = UDim2.fromOffset(3, 16), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = btn })
    Corner(ind, 2)
    self:_bindTheme(ind, "BackgroundColor3", "Accent")
    local textX = 12
    if icon and icon ~= "" then
        local id = tostring(icon)
        if not id:find("rbxasset") and not id:find("http") then id = "rbxassetid://" .. id end
        tab.IconImage = New("ImageLabel", { Position = UDim2.new(0, 12, 0.5, -8), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = id, Parent = btn })
        textX = 36
    end
    tab.Label = self:_label(btn, { Position = UDim2.fromOffset(textX, 0), Size = UDim2.new(1, -textX - 6, 1, 0), Text = tab.Name, Font = Enum.Font.GothamMedium }, "SubText")
    tab.Button, tab.Indicator = btn, ind

    local page = New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = self._pages,
    })
    self:_bindTheme(page, "ScrollBarImageColor3", "Accent")
    ListLayout(page, 8)
    Padding(page, 12, 4, 14, 12)
    tab.Page = page

    btn.MouseEnter:Connect(function() if self.CurrentTab ~= tab then Tween(btn, 0.12, { BackgroundTransparency = 0.6, BackgroundColor3 = self.Theme.Element }) end end)
    btn.MouseLeave:Connect(function() if self.CurrentTab ~= tab then Tween(btn, 0.12, { BackgroundTransparency = 1 }) end end)
    btn.MouseButton1Click:Connect(function() tab:Select() end)
    self:_bind(btn, function() tab:_paint(true) end)
    table.insert(self._allTabs, tab)
    return tab
end

function WindowClass:AddTab(name, icon)
    local tab = self:_newTab(name, icon, self._tabList)
    table.insert(self.Tabs, tab)
    if not self.CurrentTab then tab:Select() end
    return tab
end

function WindowClass:GetTab(name)
    for _, t in ipairs(self._allTabs) do if t.Name == name then return t end end
end
function WindowClass:SelectTab(t)
