function TabClass:_paint(instant)
    local win = self.Window
    local active = win.CurrentTab == self
    local t = instant and 0 or 0.15
    Tween(self.Button, t, { BackgroundTransparency = active and 0 or 1, BackgroundColor3 = win.Theme.Element })
    Tween(self.Label, t, { TextColor3 = active and win.Theme.Text or win.Theme.SubText })
    Tween(self.Indicator, t, { BackgroundTransparency = active and 0 or 1 })
    if self.IconImage then Tween(self.IconImage, t, { ImageColor3 = active and win.Accent or win.Theme.SubText }) end
end

function TabClass:Select()
    local win = self.Window
    win.CurrentTab = self
    for _, t in ipairs(win._allTabs) do t.Page.Visible = (t == self); t:_paint() end
    win.TabTitle.Text = self.Name
    win:_applySearch()
end

