----------------------------------------------------------------------
-- Window: appearance / behaviour
----------------------------------------------------------------------
function WindowClass:Show()
    self.Visible = true
    self._token = (self._token or 0) + 1
    self.Root.Visible = true
    self._uiScale.Scale = self.Scale * 0.94
    Tween(self._uiScale, 0.18, { Scale = self.Scale }, Enum.EasingStyle.Back)
end
function WindowClass:Hide()
    self.Visible = false
    self._tip.Frame.Visible = false
    self._token = (self._token or 0) + 1
    local token = self._token
    Tween(self._uiScale, 0.15, { Scale = self.Scale * 0.94 })
    task.delay(0.16, function() if self._token == token and not self.Destroyed then self.Root.Visible = false end end)
end
function WindowClass:Toggle() if self.Visible then self:Hide() else self:Show() end end
function WindowClass:IsVisible() return self.Visible end

function WindowClass:SetAccent(color)
    if typeof(color) ~= "Color3" then return end
    self.Accent = color
    self:_refreshTheme()
end
function WindowClass:SetTheme(name)
    if not Themes[name] then return false end
    self.ThemeName, self.Theme = name, Themes[name]
    self:_refreshTheme()
    return true
end
function WindowClass:GetThemes() return { table.unpack(ThemeOrder) } end
function WindowClass:SetScale(n)
    self.Scale = math.clamp(tonumber(n) or 1, 0.6, 1.6)
    self._uiScale.Scale = self.Scale
end
function WindowClass:SetToggleKey(key)
    if typeof(key) == "EnumItem" then key = key.Name end
    self.ToggleKeyName = tostring(key)
    if self._menuKeyEl and self._menuKeyEl.Value ~= self.ToggleKeyName then self._menuKeyEl:Set(self.ToggleKeyName, true) end
end
function WindowClass:SetTitle(t) self.Title = t; self._titleLabel.Text = t end
function WindowClass:SetSubtitle(t) self.Subtitle = t; self._subLabel.Text = t end
function WindowClass:SetLocked(state) self.Locked = state and true or false end
function WindowClass:SetNotificationsEnabled(state) self.NotificationsEnabled = state and true or false end
function WindowClass:SetWatermarkVisible(state) self._watermark.Visible = state and true or false end
function WindowClass:OnUnload(fn) table.insert(self._unloadCallbacks, fn) end
function WindowClass:Connect(signal, fn) return self:_connect(signal, fn) end
function WindowClass:GetFlag(flag) return self.Flags[flag] end
function WindowClass:SetFlag(flag, value)
    local el = self.Elements[flag]
    if el and el.Set then el:Set(value) return true end
    return false
end

function WindowClass:Notify(o)
    if type(o) == "string" then o = { Content = o } end
    o = o or {}
    if not self.NotificationsEnabled and not o.Force then return end
    local color = NotifyColors[o.Type] or self.Accent
    local duration = o.Duration or 4

    local wrap = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = self._notifHolder })
    local card = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(1.2, 0, 0, 0),
        BackgroundColor3 = self.Theme.Section, BorderSizePixel = 0, Parent = wrap,
    })
    Corner(card, 8); Stroke(card, self.Theme.Stroke, 1)
    local body = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = card })
    ListLayout(body, 2); Padding(body, 16, 9, 12, 12)
    New("Frame", { Size = UDim2.new(0, 3, 1, -14), Position = UDim2.fromOffset(6, 7), BackgroundColor3 = color, BorderSizePixel = 0, Parent = card })
    local function txt(text, font, size, colr, order)
        return New("TextLabel", {
            Size = UDim2.new(1, 0, 0, size + 2), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = text,
            Font = font, TextSize = size, TextColor3 = colr, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = order, Parent = body,
        })
    end
    if o.Title and o.Title ~= "" then txt(o.Title, Enum.Font.GothamBold, 14, self.Theme.Text, 1) end
    if o.Content and o.Content ~= "" then txt(o.Content, Enum.Font.Gotham, 12, self.Theme.SubText, 2) end
    local prog = New("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = color, BorderSizePixel = 0, Parent = card })

    Tween(card, 0.3, { Position = UDim2.new() }, Enum.EasingStyle.Quint)
    Tween(prog, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
    task.delay(duration, function()
        if wrap.Parent then
            Tween(card, 0.25, { Position = UDim2.new(1.2, 0, 0, 0) }, Enum.EasingStyle.Quint)
            task.wait(0.28)
            wrap:Destroy()
        end
    end)
end

----------------------------------------------------------------------
-- Config system
----------------------------------------------------------------------
function WindowClass:_mem()
    Aurora._Memory[self._rootDir] = Aurora._Memory[self._rootDir] or { configs = {} }
    return Aurora._Memory[self._rootDir]
end
function WindowClass:_ensureFolders()
    if not FS.Available then return end
    pcall(function()
        for _, p in ipairs({ "Aurora", self._rootDir, self._configDir }) do
            if not isfolder(p) then makefolder(p) end
        end
    end)
end
function WindowClass:IsPersistent() return FS.Available end

function WindowClass:ExportConfig()
    local data = {}
    for flag, el in pairs(self.Elements) do
        if el.Serialize then data[flag] = el:Serialize() end
    end
    data._meta = { lib = "Aurora", version = Aurora.Version, title = self.Title, saved = os.time() }
    return HttpService:JSONEncode(data)
end

function WindowClass:ImportConfig(json)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, tostring(json))
    if not ok or type(data) ~= "table" then return false, "Invalid config data" end
    local count = 0
    for flag, value in pairs(data) do
        if flag:sub(1, 1) ~= "_" then
            local el = self.Elements[flag]
            if el and el.Deserialize then
                local okSet = pcall(el.Deserialize, el, value)
                if okSet then count = count + 1 end
            end
        end
    end
    return true, count
end

function WindowClass:SaveConfig(name)
    name = CleanName(name)
    if name == "" then return false, "Invalid config name" end
    local json = self:ExportConfig()
    if FS.Available then
        self:_ensureFolders()
        local ok, err = pcall(writefile, self._configDir .. "/" .. name .. ".json", json)
        if not ok then return false, tostring(err) end
    else
        self:_mem().configs[name] = json
    end
    return true
end

function WindowClass:LoadConfig(name)
    name = CleanName(name)
    if name == "" then return false, "Invalid config name" end
    local json
    if FS.Available then
        local path = self._configDir .. "/" .. name .. ".json"
        local okExists, exists = pcall(isfile, path)
        if not okExists or not exists then return false, "Config not found" end
        local ok, data = pcall(readfile, path)
        if not ok then return false, tostring(data) end
        json = data
    else
        json = self:_mem().configs[name]
        if not json then return false, "Config not found" end
    end
    return self:ImportConfig(json)
end

function WindowClass:DeleteConfig(name)
    name = CleanName(name)
    if name == "" then return false, "Invalid config name" end
    if FS.Available then
        if not FS.CanDelete then return false, "delfile is not available in this environment" end
        local ok, err = pcall(delfile, self._configDir .. "/" .. name .. ".json")
        if not ok then return false, tostring(err) end
    else
        self:_mem().configs[name] = nil
    end
    if self:GetAutoload() == name then self:ClearAutoload() end
    return true
end

function WindowClass:GetConfigs()
    local list = {}
    if FS.Available then
        self:_ensureFolders()
        local ok, files = pcall(listfiles, self._configDir)
        if ok and type(files) == "table" then
            for _, f in ipairs(files) do
                local n = tostring(f):match("([^/\\]+)%.json$")
                if n then table.insert(list, n) end
            end
        end
    else
        for n in pairs(self:_mem().configs) do table.insert(list, n) end
    end
    table.sort(list)
    return list
end

function WindowClass:SetAutoload(name)
    name = CleanName(name)
    if name == "" then return false end
    if FS.Available then
        self:_ensureFolders()
        return (pcall(writefile, self._rootDir .. "/autoload.txt", name))
    end
    self:_mem().autoload = name
    return true
end
function WindowClass:ClearAutoload()
    if FS.Available then
        pcall(writefile, self._rootDir .. "/autoload.txt", "")
    else
        self:_mem().autoload = nil
    end
end
function WindowClass:GetAutoload()
    local name
    if FS.Available then
        local ok, exists = pcall(isfile, self._rootDir .. "/autoload.txt")
        if ok and exists then
            local okR, data = pcall(readfile, self._rootDir .. "/autoload.txt")
            if okR then name = CleanName(data) end
        end
    else
        name = self:_mem().autoload
    end
    if name == "" then name = nil end
    return name
end
function WindowClass:LoadAutoload()
    local name = self:GetAutoload()
    if not name then return false, "No autoload set" end
    local ok, res = self:LoadConfig(name)
    if ok then self:Notify({ Title = "Config", Content = "Autoloaded '" .. name .. "'", Type = "Success" }) end
    return ok, res
end

function WindowClass:ResetToDefaults()
    for flag, el in pairs(self.Elements) do
        local d = self.Defaults[flag]
        if d ~= nil and el.Deserialize then pcall(el.Deserialize, el, d) end
    end
end

----------------------------------------------------------------------
-- Destroy
----------------------------------------------------------------------
function WindowClass:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    for _, fn in ipairs(self._unloadCallbacks) do pcall(fn) end
    for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
    self._conns = {}
    self.Gui:Destroy()
    if Aurora._Active[self._rootDir] == self then Aurora._Active[self._rootDir] = nil end
end
WindowClass.Unload = WindowClass.Destroy

----------------------------------------------------------------------
-- Built-in Settings tab
----------------------------------------------------------------------
function WindowClass:_buildSettings()
    local tab = self:_newTab("Settings", nil, self._settingsHolder)
    self.SettingsTab = tab

    -- Interface ------------------------------------------------------
    local ui = tab:AddSection("Interface")
    ui:AddDropdown({
        Name = "Theme", Flag = "ui_theme", Options = ThemeOrder, Default = self.ThemeName, Tooltip = "Switch the base colour theme.",
        Callback = function(v) if v then self:SetTheme(v) end end,
    })
    ui:AddColorPicker({
        Name = "Accent Color", Flag = "ui_accent", Default = self.Accent, Tooltip = "Main highlight colour.",
        Callback = function(c) self:SetAccent(c) end,
    })
    ui:AddSlider({
        Name = "UI Scale", Flag = "ui_scale", Min = 0.6, Max = 1.4, Default = self.Scale, Increment = 0.05, Decimals = 2,
        Callback = function(v) self:SetScale(v) end,
    })
    self._menuKeyEl = ui:AddKeybind({
        Name = "Menu Keybind", Flag = "ui_menu_key", Default = self.ToggleKeyName, Tooltip = "Key that shows / hides the menu.",
        BindChanged = function(name) self.ToggleKeyName = (name == "None") and self.ToggleKeyName or name end,
    })
    ui:AddToggle({ Name = "Lock Window Position", Flag = "ui_lock", Default = false, Callback = function(v) self:SetLocked(v) end })
    ui:AddToggle({ Name = "Show Watermark", Flag = "ui_watermark", Default = true, Callback = function(v) self:SetWatermarkVisible(v) end })
    ui:AddToggle({ Name = "Notifications", Flag = "ui_notifications", Default = true, Callback = function(v) self:SetNotificationsEnabled(v) end })

    -- Configuration --------------------------------------------------
    local cfg = tab:AddSection("Configuration")
    if not FS.Available then
        cfg:AddLabel("Filesystem unavailable: configs last for this session only.")
    end
    local nameBox = cfg:AddTextBox({ Name = "Config Name", Placeholder = "my-config", NoSave = true })
    local list = cfg:AddDropdown({ Name = "Saved Configs", Options = self:GetConfigs(), NoSave = true })
    local autoLabel
    local function refreshList()
        list:Refresh(self:GetConfigs(), true)
        autoLabel:SetText("Autoload: " .. (self:GetAutoload() or "none"))
    end
    local function selected() return list:Get() end
    local function result(ok, msg, okText)
        if ok then self:Notify({ Title = "Config", Content = okText, Type = "Success" })
        else self:Notify({ Title = "Config", Content = tostring(msg), Type = "Error" }) end
    end

    cfg:AddButton({ Name = "Create Config", Callback = function()
        local n = CleanName(nameBox:Get())
        if n == "" then return self:Notify({ Title = "Config", Content = "Enter a config name first.", Type = "Warning" }) end
        local ok, err = self:SaveConfig(n)
        result(ok, err, "Created '" .. n .. "'")
        if ok then refreshList(); list:Set(n, true) end
    end })
    cfg:AddButton({ Name = "Save Over Selected", Confirm = true, Callback = function()
        local n = selected()
        if not n then return self:Notify({ Title = "Config", Content = "Select a config first.", Type = "Warning" }) end
        local ok, err = self:SaveConfig(n)
        result(ok, err, "Saved '" .. n .. "'")
    end })
    cfg:AddButton({ Name = "Load Selected", Callback = function()
        local n = selected()
        if not n then return self:Notify({ Title = "Config", Content = "Select a config first.", Type = "Warning" }) end
        local ok, res = self:LoadConfig(n)
        result(ok, res, "Loaded '" .. n .. "' (" .. tostring(res) .. " settings)")
    end })
    cfg:AddButton({ Name = "Delete Selected", Confirm = true, Callback = function()
        local n = selected()
        if not n then return self:Notify({ Title = "Config", Content = "Select a config first.", Type = "Warning" }) end
        local ok, err = self:DeleteConfig(n)
        result(ok, err, "Deleted '" .. n .. "'")
        refreshList(); list:Set(nil, true)
    end })
    cfg:AddButton({ Name = "Refresh List", Callback = refreshList })
    cfg:AddDivider("Autoload")
    autoLabel = cfg:AddLabel("Autoload: " .. (self:GetAutoload() or "none"))
    cfg:AddButton({ Name = "Set Selected As Autoload", Callback = function()
        local n = selected()
        if not n then return self:Notify({ Title = "Config", Content = "Select a config first.", Type = "Warning" }) end
        result(self:SetAutoload(n), "Could not write autoload file", "'" .. n .. "' will load on start")
        refreshList()
    end })
    cfg:AddButton({ Name = "Clear Autoload", Callback = function() self:ClearAutoload(); refreshList() end })
    cfg:AddDivider("Share")
    cfg:AddButton({ Name = "Export Config To Clipboard", Callback = function()
        local json = self:ExportConfig()
        local copy = setclipboard or toclipboard or (Clipboard and Clipboard.set)
        if copy then
            pcall(copy, json)
            self:Notify({ Title = "Config", Content = "Copied to clipboard.", Type = "Success" })
        else
            print("[Aurora] Exported config:\n" .. json)
            self:Notify({ Title = "Config", Content = "No clipboard access - printed to console.", Type = "Warning" })
        end
    end })
    cfg:AddTextBox({ Name = "Import (paste JSON)", Placeholder = "Paste & press Enter", NoSave = true, ClearAfter = true, EnterOnly = true, Callback = function(txt)
        if not txt or txt == "" then return end
        local ok, res = self:ImportConfig(txt)
        result(ok, res, "Imported " .. tostring(res) .. " settings")
    end })
    cfg:AddDivider("Danger Zone")
    cfg:AddButton({ Name = "Reset Everything To Defaults", Confirm = true, Callback = function()
        self:ResetToDefaults()
        self:Notify({ Title = "Config", Content = "All settings reset.", Type = "Success" })
    end })

    -- Unload ---------------------------------------------------------
    local misc = tab:AddSection("Misc")
    misc:AddButton({ Name = "Unload UI", Confirm = true, Callback = function() self:Destroy() end })
    misc:AddLabel("Aurora v" .. Aurora.Version)
end

----------------------------------------------------------------------
-- CreateWindow
----------------------------------------------------------------------
function Aurora:CreateWindow(opts)
    opts = opts or {}
    local self = setmetatable({}, WindowClass)
    self.Title = opts.Title or "Aurora"
    self.Subtitle = opts.Subtitle or ""
    self.Flags, self.Elements, self.Defaults = {}, {}, {}
    self.Options = self.Elements
    self.Tabs, self._allTabs = {}, {}
    self._conns, self._binds, self._flagCount, self._unloadCallbacks = {}, {}, {}, {}
    self.ThemeName = Themes[opts.Theme] and opts.Theme or "Dark"
    self.Theme = Themes[self.ThemeName]
    self.Accent = opts.Accent or Color3.fromRGB(124, 92, 255)
    self.Scale = math.clamp(opts.Scale or 1, 0.6, 1.6)
    self.Locked, self.NotificationsEnabled, self.Visible = false, true, true
    self._search = ""

    local tk = opts.ToggleKey or Enum.KeyCode.RightShift
    self.ToggleKeyName = typeof(tk) == "EnumItem" and tk.Name or tostring(tk)

    local folder = CleanName(opts.ConfigFolder or self.Title)
    if folder == "" then folder = "Default" end
    self._rootDir = "Aurora/" .. folder
    self._configDir = self._rootDir .. "/configs"
    if Aurora._Active[self._rootDir] then pcall(function() Aurora._Active[self._rootDir]:Destroy() end) end
    Aurora._Active[self._rootDir] = self

    -- Gui ------------------------------------------------------------
    local gui = New("ScreenGui", { Name = RandomString(12), ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999 })
    MountGui(gui)
    self.Gui = gui

    local W, H = (opts.Size and opts.Size.X) or 660, (opts.Size and opts.Size.Y) or 440
