    Corner(avatar, 16)
    self:_label(card, { Position = UDim2.fromOffset(48, 7), Size = UDim2.new(1, -54, 0, 18), Text = LocalPlayer.DisplayName, Font = Enum.Font.GothamMedium, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd })
