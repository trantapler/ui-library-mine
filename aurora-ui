----------------------------------------------------------------------
-- Window internals
----------------------------------------------------------------------
function WindowClass:_connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(self._conns, c)
    return c
end

function WindowClass:_bind(anchor, fn)
    table.insert(self._binds, { anchor, fn })
    pcall(fn)
end

function WindowClass:_bindTheme(inst, prop, key)
    self:_bind(inst, function()
        inst[prop] = (key == "Accent") and self.Accent or self.Theme[key]
    end)
end

function WindowClass:_refreshTheme()
    local keep = {}
    for _, b in ipairs(self._binds) do
        if b[1].Parent ~= nil then
            table.insert(keep, b)
            pcall(b[2])
        end
    end
    self._binds = keep
end

function WindowClass:_label(parent, props, colorKey)
    if props.BackgroundTransparency == nil then props.BackgroundTransparency = 1 end
    props.Font = props.Font or Enum.Font.Gotham
    props.TextSize = props.TextSize or 13
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    props.Parent = parent
    local l = New("TextLabel", props)
    self:_bindTheme(l, "TextColor3", colorKey or "Text")
    return l
end

function WindowClass:_hover(inst, normalKey, hoverKey)
    normalKey, hoverKey = normalKey or "Element", hoverKey or "ElementHover"
    inst.MouseEnter:Connect(function() Tween(inst, 0.12, { BackgroundColor3 = self.Theme[hoverKey] }) end)
    inst.MouseLeave:Connect(function() Tween(inst, 0.12, { BackgroundColor3 = self.Theme[normalKey] }) end)
end

function WindowClass:_attachTooltip(row, text)
    if not text or text == "" then return end
    local tip = self._tip
    row.MouseEnter:Connect(function() tip.Label.Text = text; tip.Frame.Visible = true end)
    row.MouseLeave:Connect(function() tip.Frame.Visible = false end)
    row.MouseMoved:Connect(function(x, y) tip.Frame.Position = UDim2.fromOffset(x + 14, y + 18) end)
end

function WindowClass:_emit(obj, value, silent)
    if obj.Flag then self.Flags[obj.Flag] = value end
    if silent then return end
    if obj.Callback then
        local ok, err = pcall(obj.Callback, value)
        if not ok then warn("[Aurora] Callback error in '" .. tostring(obj.Name) .. "': " .. tostring(err)) end
    end
    for _, fn in ipairs(obj._listeners or {}) do pcall(fn, value) end
end

function WindowClass:_applySearch()
    local tab = self.CurrentTab
    if not tab then return end
    local q = string.lower(self._search or "")
    for _, sec in ipairs(tab.Sections) do
        local secMatch = q == "" or string.find(string.lower(sec.Name), q, 1, true) ~= nil
        local any = secMatch
        for _, el in ipairs(sec.Elements) do
            local match = secMatch or (el.Name ~= nil and string.find(string.lower(tostring(el.Name)), q, 1, true) ~= nil)
            el._filtered = not match
            el:_updateVisibility()
            if match and not el._hidden then any = true end
        end
        sec.Frame.Visible = any
    end
end

----------------------------------------------------------------------
-- Element base methods
----------------------------------------------------------------------
function ElementBase:_updateVisibility()
    self.Row.Visible = not self._hidden and not self._filtered
end
function ElementBase:SetVisible(v) self._hidden = not v; self:_updateVisibility() end
function ElementBase:OnChanged(fn) table.insert(self._listeners, fn) end
function ElementBase:SetCallback(fn) self.Callback = fn end
function ElementBase:Destroy()
    local win, sec = self.Window, self.Section
    for i, e in ipairs(sec.Elements) do if e == self then table.remove(sec.Elements, i) break end end
    if self.Flag then win.Elements[self.Flag] = nil; win.Flags[self.Flag] = nil; win.Defaults[self.Flag] = nil end
    self.Row:Destroy()
end

----------------------------------------------------------------------
-- Section
----------------------------------------------------------------------
function SectionClass:_row(height, auto)
    local win = self.Window
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, height), BorderSizePixel = 0,
        AutomaticSize = auto and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
        Parent = self.Content,
    })
    Corner(row, 6)
    win:_bindTheme(row, "BackgroundColor3", "Element")
    return row
end

function SectionClass:_register(obj, row, o, kind, saveable)
    local win = self.Window
    setmetatable(obj, ElementBase)
    obj.Type, obj.Row, obj.Window, obj.Section = kind, row, win, self
    obj.Name = obj.Name or o.Name
    obj.Callback = o.Callback
    obj._hidden, obj._listeners = false, {}

    if saveable and not o.NoSave then
        local flag = o.Flag
        if not flag then
            local base = string.format("%s.%s.%s", self.Tab.Name, self.Name, tostring(obj.Name or kind))
            local n = (win._flagCount[base] or 0) + 1
            win._flagCount[base] = n
            flag = n == 1 and base or (base .. "#" .. n)
        elseif win.Elements[flag] then
            warn("[Aurora] Duplicate flag '" .. flag .. "' - the newer element replaces the old one in configs.")
        end
        obj.Flag = flag
        win.Elements[flag] = obj
        win.Flags[flag] = obj:Get()
        win.Defaults[flag] = obj:Serialize()
    end

    win:_attachTooltip(row, o.Tooltip)
    if o.Visible == false then obj:SetVisible(false) end
    table.insert(self.Elements, obj)
    return obj
end

function SectionClass:SetCollapsed(state)
    self.Collapsed = state and true or false
    self.Content.Visible = not self.Collapsed
    self.Toggle.Text = self.Collapsed and "+" or "–"
end

function SectionClass:Destroy()
    for i, s in ipairs(self.Tab.Sections) do if s == self then table.remove(self.Tab.Sections, i) break end end
    for _, e in ipairs({ table.unpack(self.Elements) }) do e:Destroy() end
    self.Frame:Destroy()
end

-- Button -------------------------------------------------------------
function SectionClass:AddButton(o)
    o = o or {}
    local win = self.Window
    local row = self:_row(32)
    local btn = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = row })
    local label = win:_label(btn, { Size = UDim2.fromScale(1, 1), Text = o.Name or "Button", TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamMedium })
    win:_hover(row)

    local armed = false
    local function reset()
        armed = false
        label.Text = o.Name or "Button"
        win:_bindTheme(label, "TextColor3", "Text")
    end
    btn.MouseButton1Click:Connect(function()
        if o.Confirm and not armed then
            armed = true
            label.Text = "Click again to confirm"
            label.TextColor3 = NotifyColors.Warning
            task.delay(2.5, function() if armed then reset() end end)
            return
        end
        if armed then reset() end
        row.BackgroundColor3 = win.Accent
        Tween(row, 0.25, { BackgroundColor3 = win.Theme.ElementHover })
        if o.Callback then
            local ok, err = pcall(o.Callback)
            if not ok then warn("[Aurora] Button error: " .. tostring(err)) end
        end
    end)

    local obj = {
        Name = o.Name,
        Get = function() return nil end,
        Serialize = function() return nil end,
    }
    function obj:SetText(t) o.Name = t; self.Name = t; label.Text = t end
    function obj:Fire() if o.Callback then task.spawn(o.Callback) end end
    return self:_register(obj, row, o, "Button", false)
end

-- Toggle -------------------------------------------------------------
function SectionClass:AddToggle(o)
    o = o or {}
    local win = self.Window
    local row = self:_row(32)
    win:_label(row, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -60, 1, 0), Text = o.Name or "Toggle" })
    local sw = New("Frame", { Size = UDim2.fromOffset(34, 18), Position = UDim2.new(1, -44, 0.5, -9), Parent = row })
    Corner(sw, 9)
    local knob = New("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.new(0, 3, 0.5, -6), BackgroundColor3 = Color3.new(1, 1, 1), Parent = sw })
    Corner(knob, 6)
    local btn = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = row })
    win:_hover(row)

    local obj = { Name = o.Name, Value = o.Default == true }
    local function render(animate)
        local t = animate and 0.15 or 0
        Tween(sw, t, { BackgroundColor3 = obj.Value and win.Accent or win.Theme.Stroke })
        Tween(knob, t, { Position = obj.Value and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6) })
    end
    function obj:Get() return self.Value end
    function obj:Serialize() return self.Value end
    function obj:Set(v, silent)
        self.Value = v and true or false
        render(true)
        win:_emit(self, self.Value, silent)
    end
    function obj:Deserialize(v) self:Set(v == true) end
    function obj:Toggle() self:Set(not self.Value) end
    btn.MouseButton1Click:Connect(function() obj:Set(not obj.Value) end)
    win:_bind(sw, function() render(false) end)
    return self:_register(obj, row, o, "Toggle", true)
end

-- Slider -------------------------------------------------------------
function SectionClass:AddSlider(o)
    o = o or {}
    local win = self.Window
    local min, max = o.Min or 0, o.Max or 100
    local inc = o.Increment or 1
    local dec = o.Decimals or Decimals(inc)
    local suffix = o.Suffix or ""
    local row = self:_row(46)
    win:_label(row, { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -90, 0, 20), Text = o.Name or "Slider" })
    local box = New("TextBox", {
        Size = UDim2.fromOffset(64, 20), Position = UDim2.new(1, -74, 0, 4), BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right,
        ClearTextOnFocus = false, Text = "", Parent = row,
    })
    win:_bindTheme(box, "TextColor3", "Accent")
    local bar = New("Frame", { Position = UDim2.new(0, 10, 0, 32), Size = UDim2.new(1, -20, 0, 6), Parent = row })
    Corner(bar, 3)
    win:_bindTheme(bar, "BackgroundColor3", "Stroke")
    local fill = New("Frame", { Size = UDim2.fromScale(0, 1), Parent = bar })
    Corner(fill, 3)
    win:_bindTheme(fill, "BackgroundColor3", "Accent")
    local knob = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2, Parent = bar })
    Corner(knob, 6)
    local hit = New("TextButton", { Position = UDim2.new(0, 10, 0, 24), Size = UDim2.new(1, -20, 0, 22), BackgroundTransparency = 1, Text = "", Parent = row })
    win:_hover(row)

    local obj = { Name = o.Name }
    obj.Value = math.clamp(o.Default or min, min, max)
    local function render()
        local rel = (max - min) == 0 and 0 or (obj.Value - min) / (max - min)
        fill.Size = UDim2.fromScale(rel, 1)
        knob.Position = UDim2.fromScale(rel, 0.5)
        box.Text = Fmt(obj.Value, dec) .. suffix
    end
    function obj:Get() return self.Value end
    function obj:Serialize() return self.Value end
    function obj:Set(v, silent)
        v = tonumber(v) or self.Value
        v = math.clamp(Round(v - min, inc) + min, min, max)
        self.Value = tonumber(Fmt(v, dec))
        render()
        win:_emit(self, self.Value, silent)
    end
    function obj:Deserialize(v) self:Set(v) end
    function obj:SetRange(newMin, newMax) min, max = newMin, newMax; self:Set(self.Value, true) end

    local dragging = false
    hit.InputBegan:Connect(function(i) if IsPointer(i) then dragging = true end end)
    win:_connect(UserInputService.InputEnded, function(i) if IsPointer(i) then dragging = false end end)
    local function fromPos(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        local before = obj.Value
        local nv = math.clamp(Round(min + (max - min) * rel - min, inc) + min, min, max)
        if tonumber(Fmt(nv, dec)) ~= before then obj:Set(nv) end
    end
    hit.InputBegan:Connect(function(i) if IsPointer(i) then fromPos(i.Position.X) end end)
    win:_connect(UserInputService.InputChanged, function(i) if dragging and IsMove(i) then fromPos(i.Position.X) end end)

    box.Focused:Connect(function() box.Text = Fmt(obj.Value, dec) end)
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text:match("-?%d+%.?%d*"))
        if n then obj:Set(n) else render() end
    end)
    render()
    return self:_register(obj, row, o, "Slider", true)
end

-- Dropdown -----------------------------------------------------------
function SectionClass:AddDropdown(o)
    o = o or {}
    local win = self.Window
    local multi = o.Multi == true
    local options, optSet = {}, {}
    local function setOptions(list)
        options, optSet = {}, {}
        for _, v in ipairs(list or {}) do local s = tostring(v); table.insert(options, s); optSet[s] = true end
    end
    setOptions(o.Options)

    local row = self:_row(32, true)
    ListLayout(row, 0, Enum.HorizontalAlignment.Center)
    local header = New("TextButton", { Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, Text = "", LayoutOrder = 1, Parent = row })
    win:_label(header, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.5, -10, 1, 0), Text = o.Name or "Dropdown" })
    local valueLabel = win:_label(header, {
        Position = UDim2.fromScale(0.4, 0), Size = UDim2.new(0.6, -32, 1, 0), TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd, Font = Enum.Font.GothamMedium, TextSize = 12, Text = "",
    }, "Accent")
    local arrow = win:_label(header, { Position = UDim2.new(1, -22, 0, 0), Size = UDim2.fromOffset(14, 32), TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, Text = "v" }, "SubText")

    local holder = New("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, Visible = false, LayoutOrder = 2, Parent = row })
    local scroll = New("ScrollingFrame", {
        Position = UDim2.fromOffset(6, 0), Size = UDim2.new(1, -12, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = holder,
    })
    ListLayout(scroll, 2)
    win:_bindTheme(scroll, "ScrollBarImageColor3", "Accent")
    win:_hover(row)

    local obj = { Name = o.Name }
    local sel = multi and {} or nil
    local items = {}

    local function selectedList()
        local out = {}
        for _, name in ipairs(options) do if sel[name] then table.insert(out, name) end end
        return out
    end
    local function updateText()
        if multi then
            local l = selectedList()
            valueLabel.Text = #l == 0 and "None" or table.concat(l, ", ")
        else
            valueLabel.Text = sel or "None"
        end
    end
    local function paint()
        for name, b in pairs(items) do
            local on = multi and sel[name] or (not multi and sel == name)
            b.BackgroundTransparency = on and 0 or 1
            b.TextColor3 = on and win.Accent or win.Theme.SubText
        end
    end
    local function resize()
        local h = math.min(#options * 28, 140)
        scroll.Size = UDim2.new(1, -12, 0, h)
        holder.Size = UDim2.new(1, 0, 0, h + 8)
    end
    local function setOpen(state)
        obj.Open = state
        holder.Visible = state
        arrow.Text = state and "^" or "v"
    end
    local function build()
        for _, b in pairs(items) do b:Destroy() end
        items = {}
        for i, name in ipairs(options) do
            local b = New("TextButton", {
                Size = UDim2.new(1, -4, 0, 26), LayoutOrder = i, Text = "  " .. name, AutoButtonColor = false,
                Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                BorderSizePixel = 0, Parent = scroll,
            })
            Corner(b, 5)
            win:_bindTheme(b, "BackgroundColor3", "ElementHover")
            items[name] = b
            b.MouseButton1Click:Connect(function()
                if multi then
                    sel[name] = (not sel[name]) or nil
                    obj:Set(selectedList())
                else
                    obj:Set(name)
                    setOpen(false)
                end
            end)
        end
        resize(); paint(); updateText()
    end

    function obj:Get() if multi then return selectedList() end return sel end
    function obj:Serialize() if multi then return selectedList() end return sel or "" end
    function obj:Set(v, silent)
        if multi then
            sel = {}
            if type(v) == "table" then
                for k, x in pairs(v) do
                    local name = (type(k) == "number") and tostring(x) or (x == true and k or nil)
                    if name and optSet[name] then sel[name] = true end
                end
            end
        else
            if type(v) == "number" then v = options[v] end
            sel = (v ~= nil and optSet[tostring(v)]) and tostring(v) or nil
        end
        paint(); updateText()
        win:_emit(self, self:Get(), silent)
    end
    function obj:Deserialize(v) self:Set((not multi and v == "") and nil or v) end
    function obj:Refresh(newOptions, keep)
        setOptions(newOptions)
        if keep then
            if multi then for k in pairs(sel) do if not optSet[k] then sel[k] = nil end end
            elseif sel and not optSet[sel] then sel = nil end
        else
            sel = multi and {} or nil
        end
        build()
    end
    function obj:SetOpen(state) setOpen(state) end
    function obj:GetOptions() return { table.unpack(options) } end

    header.MouseButton1Click:Connect(function() setOpen(not obj.Open) end)
    win:_bind(scroll, function() paint() end)
    obj.Open = false
    build()
    if o.Default ~= nil then obj:Set(o.Default, true) end
    return self:_register(obj, row, o, multi and "MultiDropdown" or "Dropdown", true)
end

