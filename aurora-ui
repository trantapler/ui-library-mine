        PlaceholderText = "Search...", Text = "", ClearTextOnFocus = false, ClipsDescendants = true, Parent = header,
    })
    Corner(search, 6); Padding(search, 8, 0, 8, 0)
    self:_bindTheme(search, "BackgroundColor3", "Element")
    self:_bindTheme(search, "TextColor3", "Text")
    self:_bindTheme(search, "PlaceholderColor3", "SubText")
    search:GetPropertyChangedSignal("Text"):Connect(function() self._search = search.Text; self:_applySearch() end)

    local close = New("TextButton", { Position = UDim2.new(1, -36, 0.5, -13), Size = UDim2.fromOffset(26, 26), Text = "×", Font = Enum.Font.GothamBold, TextSize = 18, AutoButtonColor = false, BorderSizePixel = 0, Parent = header })
    Corner(close, 6)
    self:_bindTheme(close, "BackgroundColor3", "Element")
    self:_bindTheme(close, "TextColor3", "SubText")
    close.MouseEnter:Connect(function() Tween(close, 0.12, { BackgroundColor3 = NotifyColors.Error, TextColor3 = Color3.new(1, 1, 1) }) end)
    close.MouseLeave:Connect(function() Tween(close, 0.12, { BackgroundColor3 = self.Theme.Element, TextColor3 = self.Theme.SubText }) end)
    close.MouseButton1Click:Connect(function()
        self:Hide()
        self:Notify({ Title = self.Title, Content = "Press " .. self.ToggleKeyName .. " to reopen the menu.", Duration = 3 })
    end)

    local pages = New("Frame", { Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 1, -52), BackgroundTransparency = 1, ClipsDescendants = true, Parent = content })
    self._pages = pages

    -- Overlays: tooltip, notifications, watermark ---------------------------
    local tipFrame = New("Frame", { Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, Visible = false, ZIndex = 100, BorderSizePixel = 0, Parent = gui })
    Corner(tipFrame, 5); Padding(tipFrame, 8, 0, 8, 0)
    self:_bindTheme(tipFrame, "BackgroundColor3", "Section")
    self:_bindTheme(New("UIStroke", { Thickness = 1, Parent = tipFrame }), "Color", "Stroke")
    local tipLabel = New("TextLabel", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, ZIndex = 101, Text = "", Parent = tipFrame })
    self:_bindTheme(tipLabel, "TextColor3", "Text")
    self._tip = { Frame = tipFrame, Label = tipLabel }

    local nh = New("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.new(0, 300, 1, -32), BackgroundTransparency = 1, ZIndex = 50, Parent = gui })
    New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Bottom, Parent = nh })
    self._notifHolder = nh

    local wm = New("Frame", { Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, BorderSizePixel = 0, Parent = gui })
    Corner(wm, 6); Padding(wm, 10, 0, 10, 0)
    self:_bindTheme(wm, "BackgroundColor3", "Section")
    self:_bindTheme(New("UIStroke", { Thickness = 1, Parent = wm }), "Color", "Stroke")
    local wmBar = New("Frame", { AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(-10, 0), Size = UDim2.new(1, 20, 0, 2), BorderSizePixel = 0, Parent = wm })
    self:_bindTheme(wmBar, "BackgroundColor3", "Accent")
    local wmLabel = New("TextLabel", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 12, Text = self.Title, Parent = wm })
    self:_bindTheme(wmLabel, "TextColor3", "Text")
    self._watermark = wm

    local frames, acc = 0, 0
    self:_connect(RunService.Heartbeat, function(dt)
        frames = frames + 1; acc = acc + dt
        if acc >= 0.5 then
            local fps = math.floor(frames / acc + 0.5)
            frames, acc = 0, 0
            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            wmLabel.Text = string.format("%s  |  %d FPS  |  %d ms", self.Title, fps, ping)
        end
    end)

    -- Dragging & toggle key ----------------------------------------------
    local dragging, dragStart, startPos = false, nil, nil
    local function makeHandle(handle)
        self:_connect(handle.InputBegan, function(input)
            if self.Locked or not IsPointer(input) then return end
            dragging, dragStart, startPos = true, input.Position, root.Position
        end)
    end
    makeHandle(header)
    makeHandle(side)
    self:_connect(UserInputService.InputChanged, function(input)
        if dragging and IsMove(input) then
            local d = (input.Position - dragStart) / self.Scale
            root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    self:_connect(UserInputService.InputEnded, function(input) if IsPointer(input) then dragging = false end end)
    self:_connect(UserInputService.InputBegan, function(input, gpe)
        if gpe or self._listening then return end
        if KeyName(input) == self.ToggleKeyName then self:Toggle() end
    end)

    self:_buildSettings()
    self:Show()
    return self
end

return Aurora
