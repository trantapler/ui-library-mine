function SectionClass:AddColorPicker(o)
    o = o or {}
    local win = self.Window
    local h, s, v = (o.Default or Color3.fromRGB(255, 255, 255)):ToHSV()

    local row = self:_row(32, true)
    ListLayout(row, 0, Enum.HorizontalAlignment.Center)
    local header = New("TextButton", { Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, Text = "", LayoutOrder = 1, Parent = row })
    win:_label(header, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -60, 1, 0), Text = o.Name or "Color" })
    local swatch = New("Frame", { Position = UDim2.new(1, -46, 0.5, -8), Size = UDim2.fromOffset(34, 16), Parent = header })
    Corner(swatch, 4)
    win:_bindTheme(New("UIStroke", { Thickness = 1, Parent = swatch }), "Color", "Stroke")

    local holder = New("Frame", { Size = UDim2.new(1, 0, 0, 142), BackgroundTransparency = 1, Visible = false, LayoutOrder = 2, Parent = row })
    local sv = New("Frame", { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -52, 0, 104), BorderSizePixel = 0, Parent = holder })
    Corner(sv, 4)
    local white = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sv })
    Corner(white, 4)
    New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
    local black = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = sv })
    Corner(black, 4)
    New("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = black })
    local svCursor = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 3, Parent = sv })
    Corner(svCursor, 5); Stroke(svCursor, Color3.new(1, 1, 1), 2)

    local hue = New("Frame", { Position = UDim2.new(1, -32, 0, 4), Size = UDim2.fromOffset(18, 104), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = holder })
    Corner(hue, 4)
    New("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)), ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)), ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)), ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
        }),
        Parent = hue,
    })
    local hueCursor = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 4, 0, 4), BackgroundTransparency = 1, ZIndex = 3, Parent = hue })
    Corner(hueCursor, 2); Stroke(hueCursor, Color3.new(1, 1, 1), 2)

    local hex = New("TextBox", {
        Position = UDim2.fromOffset(10, 114), Size = UDim2.new(1, -20, 0, 22), Font = Enum.Font.GothamMedium, TextSize = 12,
        ClearTextOnFocus = false, Text = "", Parent = holder,
    })
    Corner(hex, 5)
    win:_bindTheme(hex, "BackgroundColor3", "Section")
    win:_bindTheme(hex, "TextColor3", "Text")
    win:_hover(row)

    local obj = { Name = o.Name, Open = false }
    local function color() return Color3.fromHSV(h, s, v) end
    local function render()
        local c = color()
        swatch.BackgroundColor3 = c
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.fromScale(s, 1 - v)
        hueCursor.Position = UDim2.fromScale(0.5, h)
        hex.Text = Color3ToHex(c)
    end
    function obj:Get() return color() end
    function obj:Serialize() return Color3ToHex(color()) end
    function obj:Set(c, silent)
        if type(c) == "string" then c = HexToColor3(c) end
        if typeof(c) ~= "Color3" then return end
        local nh, ns, nv = c:ToHSV()
        if ns > 0.001 and nv > 0.001 then h = nh end
        s, v = ns, nv
        render()
        win:_emit(self, color(), silent)
    end
    function obj:Deserialize(c) self:Set(c) end
    function obj:SetOpen(state) obj.Open = state; holder.Visible = state end

    local dragSV, dragHue = false, false
    sv.InputBegan:Connect(function(i) if IsPointer(i) then dragSV = true end end)
    hue.InputBegan:Connect(function(i) if IsPointer(i) then dragHue = true end end)
    win:_connect(UserInputService.InputEnded, function(i) if IsPointer(i) then dragSV, dragHue = false, false end end)
    local function update(pos)
        if dragSV then
            s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
            v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
        elseif dragHue then
            h = math.clamp((pos.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 1)
        else return end
        render()
        win:_emit(obj, color(), false)
    end
    sv.InputBegan:Connect(function(i) if IsPointer(i) then update(i.Position) end end)
    hue.InputBegan:Connect(function(i) if IsPointer(i) then update(i.Position) end end)
    win:_connect(UserInputService.InputChanged, function(i) if (dragSV or dragHue) and IsMove(i) then update(i.Position) end end)
    hex.FocusLost:Connect(function()
        local c = HexToColor3(hex.Text)
        if c then obj:Set(c) else render() end
    end)
    header.MouseButton1Click:Connect(function() obj:SetOpen(not obj.Open) end)
    render()
    return self:_register(obj, row, o, "ColorPicker", true)
end

